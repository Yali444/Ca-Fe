# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
env.local
*.local

# vercel
.vercel

# ad hoc safety backups written by scripts/*.js during manual data edits
/public/data/*.batch-backup.json

# regenerated each run of scripts/extract-phones.mjs — the harvest report and
# its proposals are working files, not source (merged into cafes.json instead)
/scripts/phones-report.csv
/scripts/phones-found.json

# typescript
*.tsbuildinfo
next-env.d.ts
