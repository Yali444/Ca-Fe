# Server-only Supabase configuration. Revoke any previously exposed key first.
# Apply supabase/migrations/202609070001_api_security.sql before enabling APIs.
# Never prefix database credentials with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_new_server_only_secret_key

# Canonical site URL — used for metadata, sitemap.xml, robots.txt and
# structured-data (JSON-LD) absolute URLs. Falls back to https://www.ca-fe.xyz
# if unset.
NEXT_PUBLIC_SITE_URL=https://www.ca-fe.xyz

# Base URL used when building shareable cafe links from the client. Falls
# back to window.location.href if unset.
NEXT_PUBLIC_BASE_URL=https://www.ca-fe.xyz

# Mailto address the "suggest a place" / "report an issue" links send to.
# Falls back to the maintainer's personal address if unset — set this in any
# fork or deployment you don't own.
NEXT_PUBLIC_REPORT_EMAIL=your-email@example.com

# Google Maps API Key — only used by the one-off scripts in scripts/
# (geocoding/verification tooling), not by the app itself.
# Get your key from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
